{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "CCDT — Real-time AIOps platform overview",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "🧠 Layer-2: Causal GNN",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "title": "GNN Inference Rate",
      "type": "stat",
      "targets": [{ "expr": "rate(ccdt_gnn_inferences_total[1m])", "legendFormat": "inferences/s", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.5 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "title": "GNN P99 Latency",
      "type": "stat",
      "targets": [{ "expr": "histogram_quantile(0.99, rate(ccdt_gnn_inference_duration_seconds_bucket[5m]))", "legendFormat": "p99", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "title": "GNN Confidence (avg)",
      "type": "stat",
      "targets": [{ "expr": "avg(ccdt_gnn_confidence_score)", "legendFormat": "confidence", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 1 },
      "id": 4,
      "options": {},
      "title": "GNN Inference Latency Distribution",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(ccdt_gnn_inference_duration_seconds_bucket[5m]))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, rate(ccdt_gnn_inference_duration_seconds_bucket[5m]))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, rate(ccdt_gnn_inference_duration_seconds_bucket[5m]))", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "🛡️ Layer-3: Guardian",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 6 },
      "id": 5,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "title": "Actions Executed (1m)",
      "type": "stat",
      "targets": [{ "expr": "increase(ccdt_guardian_actions_total{status='executed'}[1m])", "legendFormat": "executed", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 6 },
      "id": 6,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "title": "OPA Blocks (1m)",
      "type": "stat",
      "targets": [{ "expr": "increase(ccdt_guardian_opa_decisions_total{decision='deny'}[1m])", "legendFormat": "blocked", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 6 },
      "id": 7,
      "title": "Guardian Action Types",
      "type": "piechart",
      "targets": [{ "expr": "sum by (action_type) (ccdt_guardian_actions_total)", "legendFormat": "{{action_type}}", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.25 },
              { "color": "red", "value": 0.5 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 6 },
      "id": 8,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "title": "Ghost Preview Avg Risk",
      "type": "stat",
      "targets": [{ "expr": "avg(ccdt_guardian_ghost_risk_score)", "legendFormat": "risk", "refId": "A" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 },
      "id": 102,
      "title": "🤖 Layer-4: Co-Pilot",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 11 },
      "id": 9,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "title": "Active Sessions",
      "type": "stat",
      "targets": [{ "expr": "ccdt_copilot_sessions_active", "legendFormat": "sessions", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 11 },
      "id": 10,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "title": "Claude P95 Latency",
      "type": "stat",
      "targets": [{ "expr": "histogram_quantile(0.95, rate(ccdt_copilot_claude_latency_seconds_bucket[5m]))", "legendFormat": "p95", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 4, "w": 16, "x": 8, "y": 11 },
      "id": 11,
      "title": "Co-Pilot Request Rate",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(ccdt_copilot_requests_total[1m])", "legendFormat": "requests/s", "refId": "A" },
        { "expr": "rate(ccdt_copilot_errors_total[1m])", "legendFormat": "errors/s", "refId": "B" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 103,
      "title": "🔀 API Gateway",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 16 },
      "id": 12,
      "title": "Gateway Request Rate by Path",
      "type": "timeseries",
      "targets": [{ "expr": "sum by (path) (rate(ccdt_gateway_requests_total[1m]))", "legendFormat": "{{path}}", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 16 },
      "id": 13,
      "title": "Gateway HTTP Status Codes",
      "type": "timeseries",
      "targets": [{ "expr": "sum by (status) (rate(ccdt_gateway_requests_total[1m]))", "legendFormat": "HTTP {{status}}", "refId": "A" }]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["ccdt", "aiops"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
